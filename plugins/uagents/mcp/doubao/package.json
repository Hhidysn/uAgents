{
  "name": "@uagents/doubao-work-mcp",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/server.mjs --bundle --platform=node --format=esm --target=node22 --minify-whitespace --legal-comments=eof --outfile=dist/server.mjs && node scripts/normalize-bundle.mjs",
